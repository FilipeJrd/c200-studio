#!/usr/bin/env bash
set -euo pipefail
C200_APPDIR="${APPDIR:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)}"
export LD_LIBRARY_PATH="$C200_APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
# Keep compose tables in sync with the bundled xkbcommon on rolling distros.
export XLOCALEDIR="$C200_APPDIR/usr/share/X11/locale"
exec "$C200_APPDIR/usr/bin/c200-studio" "$@"
